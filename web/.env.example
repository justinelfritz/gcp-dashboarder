# Base URL of the Dashboarder API (Cloud Run URL in prod).
VITE_API_BASE_URL=http://localhost:8080

# Sign-in (Firebase Authentication: email + password). Leave unset for guest-only mode.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# Local development against the Auth emulator (firebase emulators:start --only auth):
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Also require an authenticator app code (TOTP). Needs the Firebase project upgraded to Identity
# Platform, and the API started with DASHBOARDER_REQUIRE_SECOND_FACTOR=true to match. The emulator
# can't do these codes, so leave it off locally.
# VITE_REQUIRE_SECOND_FACTOR=true
